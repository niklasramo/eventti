{
  "name": "eventti-benchmarks",
  "private": true,
  "type": "module",
  "scripts": {
    "bump-deps": "npx npm-check-updates -u",
    "format": "npm run prettier-write",
    "lint": "npm run prettier-check",
    "prettier-check": "prettier --check --no-error-on-unmatched-pattern \"./**/*\"",
    "prettier-write": "prettier --write --no-error-on-unmatched-pattern \"./**/*\"",
    "test": "node --expose-gc src/index.js"
  },
  "devDependencies": {
    "eventemitter2": "6.4.9",
    "eventemitter3": "5.0.1",
    "eventti": "latest",
    "eventti-local": "file:..",
    "mitata": "1.0.34",
    "mitt": "3.0.1",
    "nanoevents": "9.1.0",
    "prettier": "3.7.4",
    "tseep": "1.3.1"
  }
}
